# Pruning fixture (zipline#76): a declared zpr-attr/1 service whose attributes
# no policy statement references. It vends no identity attributes, so the
# identity-vendor retention rule never fires and the weaver prunes it.

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.zipline]
api = "zpr-attr/1"
url = "https://attrs.zipline.example/tenant-7"
expiration_seconds = 3600
returns_attributes = ["dept -> user.dept"]

[protocols.http]
l4protocol = "TCP"
port = 80

[services.Web]
protocol = "http"
port = 80
provider = [["device.zpr.adapter.cn", "web.zpr.org"]]
