# Deliberately failing: ca_cert_path names a PEM file with a CERTIFICATE
# marker but a truncated body, so it must be rejected at compile time.

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.zipline]
api = "zpr-attr/1"
url = "https://attrs.zipline.example/tenant-7"
ca_cert_path = "bad-ca-cert.pem"
expiration_seconds = 3600
returns_attributes = ["contractor -> #user.contractor"]

[protocols.http]
l4protocol = "TCP"
port = 80

[services.Web]
protocol = "http"
port = 80
provider = [["device.zpr.adapter.cn", "web.zpr.org"]]
