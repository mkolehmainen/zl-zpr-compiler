# minimal config so that we can test parsing the RFC zpl

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"


[trusted_services.attrs]
api = "file"
returns_attributes = [
  "color -> user.color", 
  "govt -> #user.government", 
  "clear -> user.clearance", 
  "classified -> #service.classified", 
  "uid -> user.uid" ]


[protocols.http]
l4protocol = "TCP"
port = 80

[services.server]
protocol = "http"

[services."my great service"]
protocol = "http"
provider = [[ "user.uid", "77" ]]

[services."mygreatservice"]
protocol = "http"
port = 8080
provider = [[ "user.uid", "88" ]]

[services.gateway]
protocol = "http"
