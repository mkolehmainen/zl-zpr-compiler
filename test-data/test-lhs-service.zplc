# minimal config so that we can test parsing the RFC zpl

[nodes.n0]
provider = [["device.zpr.adapter.cn", "fee"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.attrs]
api = "file"
returns_attributes = [
  "red -> #service.red", 
  "blue -> #service.blue", 
  "brown -> #service.brown", 
  "green -> #user.green", 
  "yellow -> #device.yellow", 
  "orange -> #device.orange" ]

[protocols.http]
l4protocol = "TCP"
port = 80

[protocols.dbprot]
l4protocol = "TCP"
port = 9012


[services.MyWeb]
protocol = "http"
provider = [[ "device.zpr.adapter.cn", "webserver.zpr" ]]

[services.MyDb]
protocol = "dbprot"
provider = [[ "device.zpr.adapter.cn", "dbserver.zpr" ]]
