# Deliberately failing: `service` is reserved on zpr-attr/1 (it will one day
# name an on-net path to the attribute service; today ordinary IP is the only
# mode).

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.zipline]
api = "zpr-attr/1"
url = "https://attrs.zipline.example/tenant-7"
expiration_seconds = 3600
returns_attributes = ["contractor -> #user.contractor"]
service = "attrs-proxy"

[protocols.http]
l4protocol = "TCP"
port = 80

[services.Web]
protocol = "http"
port = 80
provider = [["device.zpr.adapter.cn", "web.zpr.org"]]
