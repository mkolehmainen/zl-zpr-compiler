# minimal config so that we can test parsing the RFC zpl

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"


[trusted_services.attrs]
api = "file"
returns_attributes = [
  "govt -> #user.government", 
  "clearance -> user.clearance", 
  "classified -> #user.classified", 
  "uid -> user.uid", 
  "hard -> #device.hardened", 
  "encr -> #device.encrypted", 
  "level -> service.level" ]


[protocols.http]
l4protocol = "TCP"
port = 80

[services.server]
protocol = "http"

[services.Image-database]
protocol = "http"
provider = [[ "user.uid", "1234" ]]

[services.gateway]
protocol = "http"
