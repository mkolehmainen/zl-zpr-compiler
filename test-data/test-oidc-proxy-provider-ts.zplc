# zipline#6 review: the JWKS proxy's provider attribute (`device.color`)
# resolves through the `attrfile` trusted service, which nothing else uses.
# The dependency closure must discover it BEFORE the trusted services are
# woven, or `attrfile` gets no TrustedService record / connect entry.

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.attrfile]
api = "file"
returns_attributes = ["color -> device.color"]
expiration_seconds = 3600

[trusted_services.google]
api             = "oidc"
issuer          = "https://accounts.google.com"
jwks_uri        = "https://www.googleapis.com/oauth2/v3/certs"
client_id       = "1234567890-abcdef.apps.googleusercontent.com"
allowed_domains = ["example.com"]
seed_jwks       = "google-jwks-seed.json"
service         = "google-jwks-proxy"
expiration_seconds = 43200
returns_attributes = ["sub -> user.oidc-subject", "hd -> user.domain"]
identity_attributes = ["sub"]

[protocols.http]
l4protocol = "TCP"
port = 80

[protocols.tcp]
l4protocol = "TCP"
port = 3128

# The proxy's provider is selected by an attribute only `attrfile` vouches for.
[services.google-jwks-proxy]
protocol = "tcp"
port = 3128
provider = [["device.color", "blue"]]

[services.Webby]
protocol = "http"
port = 80
provider = [["device.zpr.adapter.cn", "webby.zpr.org"]]
