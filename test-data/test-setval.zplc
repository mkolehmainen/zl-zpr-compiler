
[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.attrs]
api = "file"
returns_attributes = [ "uid -> user.uid", "markers -> user.markers{}", "role -> user.role{}", "content -> service.content{}"]


[protocols.http]
l4protocol = "TCP"
port = 80

[services.server]
protocol = "http"

[services.WebService]
protocol = "http"

[services.FooService]
protocol = "http"
