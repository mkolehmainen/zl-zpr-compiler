# Companion config for bad-zpr-addr-node.zpl (zipline#109). Identical in shape
# to a compiling config except for the ["zpr.addr", ...] entry in the node
# provider, which is the one thing under test. The node still carries its
# legitimate zpr_address; only the provider pin is rejected.

[nodes.n0]
provider = [["device.zpr.adapter.cn", "node.zpr.org"], ["zpr.addr", "fd5a:5052:90de::1"]]
zpr_address = "fd5a:5052:90de::1"

[trusted_services.attrfile]
api = "file"
returns_attributes = ["redhead -> #user.redhead"]
expiration_seconds = 3600

[protocols.http]
l4protocol = "TCP"
port = 80

[services.web]
protocol = "http"
port = "80"
provider = [["device.zpr.adapter.cn", "web.org"]]
